rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Passengers — can read any user profile, write only their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Riders — passengers need to read the list to see available riders
    //           riders can only write their own document
    match /riders/{riderId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == riderId;
    }

    // Trips — any authenticated user can read/create/update
    //         (passenger creates, rider updates status + location)
    match /trips/{tripId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Ratings — authenticated users can read and create
    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
